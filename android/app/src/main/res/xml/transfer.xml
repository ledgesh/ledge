<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied to a new phone, cloud backup or device-to-device. The
     passwords and the device key belong to this phone's Keystore, which does
     not travel, so a copy would hold a server list it cannot use. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
