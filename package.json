{
  "name": "ledge",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start": "vite build && bun run build:cli && electrobun dev",
    "dev": "bun run build:cli && electrobun dev --watch",
    "dev:hmr": "bun run build:cli && concurrently -k \"bun run hmr\" \"electrobun dev\"",
    "hmr": "vite --port 5173",
    "build": "vite build && bun run build:cli && electrobun build",
    "release": "bun scripts/release-preflight.ts && vite build && bun run build:cli && electrobun build --env=stable",
    "build:cli": "bun build src/bun/cli.ts --target=bun --outdir=dist-cli",
    "build:native": "bun scripts/build-native.ts",
    "icon": "bun scripts/make-icon.ts",
    "mcp": "bun src/bun/mcp.ts",
    "serve": "bun src/bun/serve.ts serve",
    "cli": "bun src/bun/cli.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:e2e": "playwright test",
    "licenses": "bun scripts/licenses.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.7.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "1.18.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
