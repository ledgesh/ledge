.DS_Store

# Dependencies
node_modules/

# Build output (Vite view build + Electrobun app bundle + bundled CLI +
# the compiled PTY trampolines + the assembled ledge-server package). The
# package's hand-written half lives in npm/ and IS committed; dist-npm/ is
# what scripts/build-npm.ts assembles out of it.
dist/
dist-cli/
dist-native/
dist-ios/
dist-npm/
build/

# What `npm pack ./dist-npm` drops in the current directory, on the way to a
# publish or to a test machine.
ledge-server-*.tgz

# SwiftPM's checkouts and object files for the iOS client. Package.resolved is
# committed on purpose — the pins are the supply chain — but the tree it clones
# is a cache.
ios/.build/

# Release artifacts (the DMG, the update tarball, update.json). Tens of
# megabytes per build, and the copies that matter are the ones published.
artifacts/

# Logs
*.log

# Playwright artifacts (e2e failure traces and reports)
test-results/
playwright-report/

# Internal working notes
PLAN.md
